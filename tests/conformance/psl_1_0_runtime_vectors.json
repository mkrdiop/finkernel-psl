    {
      "id": "EVT-PRIORITY-001",
      "rule": "R-SAME-DATE-PRIORITY",
      "kind": "all_priority_permutations",
      "permutations": [
        [
          "coupon",
          "autocall",
          "capital_redemption"
        ],
        [
          "coupon",
          "capital_redemption",
          "autocall"
        ],
        [
          "autocall",
          "coupon",
          "capital_redemption"
        ],
        [
          "autocall",
          "capital_redemption",
          "coupon"
        ],
        [
          "capital_redemption",
          "coupon",
          "autocall"
        ],
        [
          "capital_redemption",
          "autocall",
          "coupon"
        ]
      ],
      "expected_count": 6
    },
    {
      "id": "EVT-TERMINAL-001",
      "rule": "R-TERMINAL-SHORT-CIRCUIT",
      "kind": "autocall_before_coupon",
      "priority": [
        "autocall",
        "coupon",
        "capital_redemption"
      ],
      "autocall_triggers": true,
      "expected_processed": [
        "AUTOCALL_EVALUATION",
        "AUTOCALL_REDEMPTION"
      ],
      "expected_state": "TERMINATED_AUTOCALL"
    },
    {
      "id": "EVT-COUPON-FIRST-001",
      "rule": "R-COUPON-MEMORY-ORDER",
      "kind": "coupon_before_autocall",
      "priority": [
        "coupon",
        "autocall",
        "capital_redemption"
      ],
      "coupon_eligible": true,
      "memory_before": "5.00",
      "current_coupon": "2.00",
      "autocall_triggers": true,
      "expected_coupon_obligation": "7.00",
      "expected_memory_after_coupon": "0",
      "expected_state": "TERMINATED_AUTOCALL"
    },
    {
      "id": "EVT-AUTOCALL-FIRST-001",
      "rule": "R-COUPON-MEMORY-ORDER",
      "kind": "autocall_before_coupon",
      "priority": [
        "autocall",
        "coupon",
        "capital_redemption"
      ],
      "coupon_eligible": true,
      "memory_before": "5.00",
      "current_coupon": "2.00",
      "autocall_triggers": true,
      "expected_coupon_obligation": "0",
      "expected_memory_after_coupon": "5.00",
      "expected_state": "TERMINATED_AUTOCALL"
    }
  ],
  "lifecycle_vectors": [
    {
      "id": "LIFE-PENDING-001",
      "rule": "R-LIFECYCLE",
      "from": "PENDING",
      "condition": "preflight_pass",
      "expected": "ACTIVE"
    },
    {
      "id": "LIFE-AUTOCALL-001",
      "rule": "R-LIFECYCLE",
      "from": "ACTIVE",
      "condition": "autocall_redemption",
      "expected": "TERMINATED_AUTOCALL"
    },
    {
      "id": "LIFE-MATURITY-001",
      "rule": "R-LIFECYCLE",
      "from": "ACTIVE",
      "condition": "maturity_redemption",
      "expected": "MATURED"
    },
    {
      "id": "LIFE-FAIL-001",
      "rule": "R-LIFECYCLE",
      "from": "ACTIVE",
      "condition": "technical_error",
      "expected": "FAILED"
    },
    {
      "id": "LIFE-TERMINAL-001",
      "rule": "R-LIFECYCLE",
      "from": "TERMINATED_AUTOCALL",
      "condition": "contractual_event",
      "expected": "REJECT_POST_TERMINAL"
    },
    {
      "id": "LIFE-FAILED-001",
      "rule": "R-LIFECYCLE",
      "from": "FAILED",
      "condition": "any_event",
      "expected": "REJECT_FAILED_RUN"
    }
  ],
  "idempotency_vectors": [
    {
      "id": "IDEMP-REPLAY-001",
      "rule": "R-IDEMPOTENCY",
