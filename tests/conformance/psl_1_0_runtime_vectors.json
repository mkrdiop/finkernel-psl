{
  "contract_id": "FINKERNEL-PSL-1.0-RUNTIME",
  "vector_set_version": "1.0.0",
  "purpose": "Executable specification vectors. These are normative examples for schedule, event ordering, settlement, fixing admission, lifecycle, idempotency and execution-eligibility rules; they do not implement the production runtime.",
  "date_vectors": [
    {
      "id": "SCH-EOM-001",
      "rule": "R-SCH-EOM",
      "kind": "monthly_anchor_eom",
      "anchor": "2024-01-31",
      "count": 5,
      "expected": [
        "2024-01-31",
        "2024-02-29",
        "2024-03-31",
        "2024-04-30",
        "2024-05-31"
      ]
    },
    {
      "id": "SCH-NON-EOM-001",
      "rule": "R-SCH-EOM",
      "kind": "monthly_anchor_day",
      "anchor": "2024-01-30",
      "count": 5,
      "expected": [
        "2024-01-30",
        "2024-02-29",
        "2024-03-30",
        "2024-04-30",
        "2024-05-30"
      ]
    },
    {
      "id": "SCH-COLLISION-001",
      "rule": "R-SCH-COLLISION",
      "kind": "adjusted_date_collision",
      "nominal": [
        "2024-06-01",
        "2024-06-02"
      ],
      "adjusted": [
        "2024-06-03",
        "2024-06-03"
      ],
      "expected": "REJECT_SCHEDULE_COLLISION"
    },
    {
      "id": "SCH-RANGE-001",
      "rule": "R-CALENDAR-RANGE",
      "kind": "calendar_out_of_range",
      "date": "2035-01-01",
      "supported_range": [
        "2020-01-01",
        "2030-12-31"
      ],
      "expected": "REJECT_CALENDAR_OUT_OF_RANGE"
    }
  ],
  "settlement_vectors": [
    {
      "id": "SET-BD-001",
      "rule": "R-SETTLEMENT-LAG",
      "kind": "business_day_lag",
      "anchor": "2024-05-24",
      "lag": 2,
      "holidays": [
        "2024-05-27"
      ],
      "weekend": [
        5,
        6
      ],
      "expected_lag_date": "2024-05-29",
      "convention": "following",
      "expected_payment_date": "2024-05-29"
    },
    {
      "id": "SET-ZERO-001",
      "rule": "R-SETTLEMENT-LAG",
      "kind": "zero_lag",
      "anchor": "2024-05-25",
      "lag": 0,
      "unit": "calendar_days",
      "weekend": [
        5,
        6
      ],
      "convention": "following",
      "expected_payment_date": "2024-05-27"
    }
  ],
  "fixing_vectors": [
    {
      "id": "FIX-EXACT-001",
      "rule": "R-FIXING-CARDINALITY",
      "kind": "exactly_one",
      "matching_records": 1,
      "expected": "ACCEPT"
    },
    {
      "id": "FIX-MISSING-001",
      "rule": "R-FIXING-CARDINALITY",
      "kind": "missing",
      "matching_records": 0,
      "expected": "REJECT_MISSING_FIXING"
    },
    {
      "id": "FIX-DUPLICATE-001",
      "rule": "R-FIXING-CARDINALITY",
      "kind": "duplicate_equal_values",
      "matching_records": 2,
      "values": [
        "100.00",
        "100.00"
      ],
      "expected": "REJECT_DUPLICATE_FIXING"
    },
    {
      "id": "FIX-CONFLICT-001",
      "rule": "R-FIXING-CARDINALITY",
      "kind": "conflicting_values",
      "matching_records": 2,
      "values": [
        "100.00",
        "99.50"
      ],
      "expected": "REJECT_DUPLICATE_FIXING"
    },
    {
      "id": "FIX-PARTIAL-BASKET-001",
      "rule": "R-FIXING-BASKET",
      "kind": "partial_basket",
      "required_underlyings": [
        "A",
        "B",
        "C"
      ],
      "present_underlyings": [
        "A",
        "B"
      ],
      "expected": "REJECT_INCOMPLETE_BASKET"
    },
    {
      "id": "FIX-NO-CARRY-001",
      "rule": "R-FIXING-FALLBACK",
      "kind": "prior_date_only",
      "requested_date": "2024-06-03",
      "available_dates": [
        "2024-05-31"
      ],
      "expected": "REJECT_MISSING_FIXING"
    }
  ],
  "event_order_vectors": [
    {
      "id": "EVT-PHASE-001",
      "rule": "R-EVENT-PHASE",
      "kind": "phase_order",
      "input": [
        "COUPON_EVALUATION",
