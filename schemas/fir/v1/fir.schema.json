{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finkernel.dev/schemas/fir/v1/fir.schema.json",
  "title": "Finkernel FIR 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["fir_version", "product", "terms", "underlyings", "reference", "observation_schedule", "components", "execution_terms"],
  "properties": {
    "fir_version": {"const": "1.0"},
    "product": {"type": "object", "additionalProperties": false, "required": ["id", "name", "category", "subtype", "currency"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "category": {"type": "string"}, "subtype": {"type": "string"}, "currency": {"type": "string"}}},
    "terms": {"type": "object", "additionalProperties": false, "required": ["notional", "inception_date", "maturity_date", "settlement"], "properties": {"notional": {"type": "object", "additionalProperties": false, "required": ["amount", "currency"], "properties": {"amount": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "currency": {"type": "string"}}}, "inception_date": {"type": "string", "format": "date"}, "maturity_date": {"type": "string", "format": "date"}, "settlement": {"type": "object", "additionalProperties": false, "required": ["currency", "payment_lag", "payment_lag_unit"], "properties": {"currency": {"type": "string"}, "payment_lag": {"type": "integer"}, "payment_lag_unit": {"type": "string"}}}}},
    "underlyings": {"type": "array", "items": {"type": "object", "required": ["id", "type", "name", "currency"], "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "name": {"type": "string"}, "currency": {"type": "string"}, "market_identifier": {"type": ["object", "null"]}}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["aggregation", "underlyings"], "properties": {"aggregation": {"type": "string"}, "underlyings": {"type": "array", "items": {"type": "string"}}}},
    "observation_schedule": {"type": "object", "additionalProperties": false, "required": ["frequency", "first_observation", "calendar", "business_day_convention"], "properties": {"frequency": {"type": "string"}, "first_observation": {"type": "string", "format": "date"}, "calendar": {"type": "string"}, "business_day_convention": {"type": "string"}}},
    "components": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "params"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "params": {"type": "object"}}}},
    "execution_terms": {"type": "object", "additionalProperties": false, "required": ["performance", "coupon", "same_date_priority", "autocall_redemption", "maturity_redemption", "settlement_calendar", "settlement_business_day_convention"], "properties": {"performance": {"type": "object"}, "coupon": {"type": "object"}, "same_date_priority": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true}, "autocall_redemption": {"type": "object"}, "maturity_redemption": {"type": "object"}, "settlement_calendar": {"type": "string"}, "settlement_business_day_convention": {"type": "string"}}}
  }
}
